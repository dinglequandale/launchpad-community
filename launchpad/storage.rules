rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {

    // Default: No public access
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User profile pictures (actual path: profile_pictures/pfp_{userId})
    match /profile_pictures/{fileName} {
      allow read: if true; // Public read access for profile pictures
      allow write: if request.auth != null; // Any authenticated user can write their own pfp
    }

    // User resumes (actual paths: resumes/resume_{userId}.pdf OR resumes/{userId})
    match /resumes/{fileName} {
      allow read: if request.auth != null; // Authenticated users can read
      allow write: if request.auth != null; // Any authenticated user can write their own resume
    }

    // Feedback attachments (screenshots)
    match /feedback/{allPaths=**} {
      allow read: if request.auth != null; // Authenticated users can read
      allow write: if request.auth != null; // Any authenticated user can upload feedback attachments
    }

    // Opportunity/Organization logos (actual path: opportunity-logos/{opportunityId})
    match /opportunity-logos/{opportunityId} {
      allow read: if true; // Public read access for opportunity logos
      allow write: if request.auth != null; // Authenticated users can write
    }
  }
}
