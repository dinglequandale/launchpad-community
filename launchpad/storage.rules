rules_version = '2';

// Every write is restricted to the uploader's own files, with size and content-type
// limits. Previously any signed-in user could overwrite anyone else's profile
// picture, resume or opportunity logo, with no size limit.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isImage(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isDocument(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'application/msword'
            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    // Default: no access.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Profile pictures: profile_pictures/pfp_{uid}
    match /profile_pictures/{fileName} {
      allow read: if true;
      allow write: if signedIn()
                   && fileName == 'pfp_' + request.auth.uid
                   && (request.resource == null || isImage(5));
    }

    // Resumes: resumes/resume_{uid}.pdf, resumes/resume_{uid}, resumes/{uid}
    match /resumes/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && (fileName == 'resume_' + request.auth.uid + '.pdf'
                       || fileName == 'resume_' + request.auth.uid
                       || fileName == request.auth.uid)
                   && (request.resource == null || isDocument(10));
    }

    // Feedback screenshots: feedback/{uid}/{file}
    match /feedback/{userId}/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && isImage(10);
    }

    // Opportunity logos: opportunity-logos/{opportunityId}. Only the opportunity's creator
    // (community opportunities, or society-scoped HSFS opportunities).
    function createdOpportunity(opportunityId) {
      let community = /databases/(default)/documents/opportunities/$(opportunityId);
      let hsfs = /databases/(default)/documents/societies/hsfs/opportunities/$(opportunityId);
      return (firestore.exists(community) && firestore.get(community).data.createdBy == request.auth.uid)
          || (firestore.exists(hsfs) && firestore.get(hsfs).data.createdBy == request.auth.uid);
    }

    match /opportunity-logos/{opportunityId} {
      allow read: if true;
      allow write: if signedIn()
                   && createdOpportunity(opportunityId)
                   && (request.resource == null || isImage(5));
    }

    // 6 degree program application materials: 6_degree_applications/{uid}_{...}
    match /6_degree_applications/{fileName} {
      allow read: if signedIn() && fileName.matches(request.auth.uid + '_.*');
      allow create: if signedIn()
                    && fileName.matches(request.auth.uid + '_.*')
                    && isDocument(10);
    }
  }
}
