# Copy to .env (or .env.local) and fill in. Every VITE_* value is bundled into the
# browser build, so ONLY put public client configuration here -- never secrets.
VITE_API_KEY=                 # Firebase web API key
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=
VITE_STREAM_API_KEY=          # Stream Chat *public* API key (the secret lives in functions/.env)
