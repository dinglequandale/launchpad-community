rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read all user profiles (community-wide)
      allow read: if request.auth != null;
      // Users can only modify their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Connections collection
    match /connections/{connectionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Opportunities collection - TEMPORARILY OPEN FOR POPULATION
    match /opportunities/{opportunityId} {
      allow read: if request.auth != null;
      // TEMPORARY: Allow any authenticated user to create opportunities
      // TODO: After population, change this to:
      // allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      // allow update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
      allow write: if request.auth != null;
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Invitation batches
    match /invitation_batches/{batchId} {
      allow read, write: if request.auth != null;
    }

    // Mail queue
    match /mail/{emailId} {
      allow read, write: if request.auth != null;
    }

    // High schools collection - dynamic, user-contributed
    match /high_schools/{schoolId} {
      // Anyone authenticated can read all high schools
      allow read: if request.auth != null;
      // Anyone authenticated can create new high schools (for adding unlisted schools)
      // But cannot update or delete existing ones (prevent vandalism)
      allow create: if request.auth != null
                    && request.resource.data.label is string
                    && request.resource.data.label.size() > 0
                    && request.resource.data.value is string;
    }

    // Onboarding analytics collection
    match /onboarding_analytics/{dateId} {
      // Allow authenticated users to read analytics
      allow read: if request.auth != null;
      // Allow authenticated users to create and update daily analytics
      // This is needed for the trackOnboardingSubmission function
      allow create, update: if request.auth != null
                            && request.resource.data.date is string
                            && request.resource.data.count is number
                            && request.resource.data.firstNames is list;
    }
  }
}
